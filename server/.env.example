# Real environment variables (systemd, Docker, your shell) override this file.

# --- AI models -------------------------------------------------------------------------------
# These are only the starting point: change ZENO's and the Bits' models (and add API keys for
# Gemini, Claude or OpenAI) on the dashboard under Settings → AI models.

# ZENO, the voice assistant (any OpenAI-compatible endpoint). Lemonade on the home server:
LLM_BASE_URL=http://192.168.1.252:13305/v1
LLM_MODEL=Qwen3.8-Flash-Next-GGUF-IQ3_M
LLM_API_KEY=not-needed
LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Local Ollama on the Mac (fallback when away from the home network):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3.5:latest
# LLM_EXTRA_BODY={"reasoning_effort": "none"}

# The Bits' model; each setting falls back to ZENO's.
# BIT_LLM_BASE_URL=
# BIT_LLM_MODEL=
# BIT_LLM_API_KEY=
# BIT_LLM_EXTRA_BODY=

# --- Bits (worker agents) ----------------------------------------------------------------------
# How many Bits one user can have working at once (BIT-01 … BIT-0N).
MAX_BITS=3
# One storage pool per user, shared by all of that user's Bits.
BIT_STORAGE_GB=10
# Limits for each stretch of work (they reset after a Bit waits or keeps watch, so a Bit can
# keep watch for days). Tokens count what the provider didn't serve from its cache.
BIT_MAX_STEPS=60
BIT_MAX_TOKENS=600000
BIT_COMMAND_TIMEOUT=600
# The Docker sandbox each working Bit gets. Without Docker, Bits still work with files and apps.
# "auto" builds ZENO's own image (Python + PDF/OCR/media tools) on first start.
SANDBOX_IMAGE=auto
SANDBOX_CPUS=1
SANDBOX_MEMORY=1g
# "bridge" gives Bits internet access; "none" cuts them off.
SANDBOX_NETWORK=bridge
# DOCKER_BIN=/usr/bin/docker
# How code in a sandbox reaches ZENO to use the user's apps. Default: this server's port on the
# Docker host (http://host.docker.internal:7860). Behind a tunnel with ZENO on localhost, use the
# public URL, e.g. https://zeno.example.com.
# BIT_GATEWAY_URL=

# --- Speech ------------------------------------------------------------------------------------
# "mlx" on Apple silicon, "faster-whisper" on Linux/Windows (CPU or CUDA), or "auto".
STT_ENGINE=auto
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo-q4
FASTER_WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
FASTER_WHISPER_DEVICE=auto
FASTER_WHISPER_COMPUTE_TYPE=int8
KOKORO_VOICE=af_heart

# --- Server ------------------------------------------------------------------------------------
ZENO_HOST=0.0.0.0
ZENO_PORT=7860
# Where the database and the Bits' workspaces live (default: server/data). Use a persistent disk.
# DATA_DIR=/var/lib/zeno
# Origins that may call the API from a browser: the dev server and your public URL.
CORS_ORIGINS=http://localhost:5180

# --- Voice connections (WebRTC) ----------------------------------------------------------------
ICE_SERVERS=stun:stun.l.google.com:19302
# Behind a Cloudflare Tunnel or NAT, voice audio needs a TURN relay (the tunnel only carries
# HTTP). Either Cloudflare's TURN service (Cloudflare dashboard → Realtime → TURN):
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# … or any TURN server, e.g. coturn:
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# --- Pipedream Connect (Outlook, Gmail, Calendar, Lucid) ---------------------------------------
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
PIPEDREAM_ENVIRONMENT=development

# --- Login (Sign in with Google) ---------------------------------------------------------------
# Comma-separated OAuth client IDs (web, and later Android) whose sign-ins are accepted.
GOOGLE_CLIENT_IDS=
# Comma-separated emails allowed to sign in; empty allows any Google account.
ALLOWED_EMAILS=
# Who can change server-wide settings (AI models, API keys); empty = the first person who signed in.
ADMIN_EMAILS=
# Random string that signs session tokens and encrypts stored API keys:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out and makes saved API keys unreadable (re-enter them).
SESSION_SECRET=
